# Copy to .env (same folder as compose.yaml) to override the dev defaults.
# Every value is optional; `docker compose up` works without a .env file.

# Change all of these before exposing the app beyond your own laptop.
SECRET_KEY=change-me
POSTGRES_PASSWORD=sentinel
EDGE_API_KEY=change-me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too
# Used by scripts/alert_player.py (set the same value there via ALERT_PLAYER_KEY)
ALERT_PLAYER_KEY=change-me

# Add your laptop's LAN IP to open the dashboard from a phone, e.g. 192.168.1.20
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Time zone for camera person-alert From/To times
ALERT_TIME_ZONE=Asia/Karachi

# Performance
# Seconds between background camera checks, 0 = off
CAMERA_MONITOR_INTERVAL=10
# Person-detection passes per second per camera
LIVE_DETECT_FPS=4
OPENCV_THREADS=2
CONTINUOUS_RECORDING=False

# Storage: local (default) or minio (needs: docker compose --profile storage up)
EVIDENCE_STORAGE_BACKEND=local

# Optional richer scene descriptions via Ollama running on the host
VISION_LLM_BASE_URL=http://host.docker.internal:11434/v1
